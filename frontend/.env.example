# Forcecast Frontend - Environment Variables
# Copy to .env.local and update

# Backend API URL (update after backend deploy)
VITE_API_BASE=https://forcecast-mvp.fly.dev/api/v1

# For local development:
# VITE_API_BASE=http://localhost:8000/api/v1

# Cloudflare Turnstile (CAPTCHA)
# Get site key from: https://dash.cloudflare.com/turnstile
VITE_TURNSTILE_SITE_KEY=